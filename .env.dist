PORT=8000
NODE_ENV=development

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=express_jwt_db
DB_SSL=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=86400

# CORS Configuration
CORS_ORIGIN=*

# Bcrypt Configuration
BCRYPT_ROUNDS=10